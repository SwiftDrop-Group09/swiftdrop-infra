# Each developer fills these local-only connection strings from their own
# provisioned Neon role credentials. Do not commit the populated .env file.
IDENTITY_DATABASE_CONNECTION_STRING=Host=ep-your-endpoint.region.aws.neon.tech;Port=5432;Database=swiftdrop_identity;Username=identity_app;Password=REPLACE_ME;SSL Mode=Require
DELIVERY_DATABASE_CONNECTION_STRING=Host=ep-your-endpoint.region.aws.neon.tech;Port=5432;Database=swiftdrop_delivery;Username=delivery_app;Password=REPLACE_ME;SSL Mode=Require
MERCHANT_DATABASE_CONNECTION_STRING=Host=ep-your-endpoint.region.aws.neon.tech;Port=5432;Database=swiftdrop_merchant;Username=merchant_app;Password=REPLACE_ME;SSL Mode=Require
NOTIFICATIONS_DATABASE_CONNECTION_STRING=Host=ep-your-endpoint.region.aws.neon.tech;Port=5432;Database=swiftdrop_notifications;Username=notifications_app;Password=REPLACE_ME;SSL Mode=Require

# One-shot Identity migrations use a separate, DDL-capable migration login.
IDENTITY_MIGRATION_CONNECTION_STRING=Host=ep-your-endpoint.region.aws.neon.tech;Port=5432;Database=swiftdrop_identity;Username=identity_migrator;Password=REPLACE_WITH_IDENTITY_MIGRATOR_PASSWORD;SSL Mode=Require

# Generated automatically by run.sh on first use. Do not commit development/.env.
RABBITMQ_DEFAULT_PASS=GENERATE_LOCALLY
