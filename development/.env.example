# These six names are the current secret inputs. Set them privately here or
# export them from your secret store; exported values take precedence.
# Neon is the selected PostgreSQL provider. Use the actual provisioned role,
# endpoint and TLS settings; no role name/password is supplied by this example.
# Never commit the populated .env file or print rendered Compose configuration.
IDENTITY_DATABASE_CONNECTION_STRING=Host=ep-your-endpoint.region.aws.neon.tech;Port=5432;Database=swiftdrop_identity;Username=REPLACE_WITH_IDENTITY_ROLE;Password=REPLACE_WITH_PRIVATE_PASSWORD;SSL Mode=Require
DELIVERY_DATABASE_CONNECTION_STRING=Host=ep-your-endpoint.region.aws.neon.tech;Port=5432;Database=swiftdrop_delivery;Username=REPLACE_WITH_DELIVERY_ROLE;Password=REPLACE_WITH_PRIVATE_PASSWORD;SSL Mode=Require
MERCHANT_DATABASE_CONNECTION_STRING=Host=ep-your-endpoint.region.aws.neon.tech;Port=5432;Database=swiftdrop_merchant;Username=REPLACE_WITH_MERCHANT_ROLE;Password=REPLACE_WITH_PRIVATE_PASSWORD;SSL Mode=Require
NOTIFICATIONS_DATABASE_CONNECTION_STRING=Host=ep-your-endpoint.region.aws.neon.tech;Port=5432;Database=swiftdrop_notifications;Username=REPLACE_WITH_NOTIFICATIONS_ROLE;Password=REPLACE_WITH_PRIVATE_PASSWORD;SSL Mode=Require

# One-shot Identity migrations use a separate, DDL-capable migration login.
# Delivery's explicit migration task reuses DELIVERY_DATABASE_CONNECTION_STRING.
# Its provisioned role needs DDL privileges for the Delivery schema when running
# that task; the runner does not create roles, grant privileges or migrate on up.
IDENTITY_MIGRATION_CONNECTION_STRING=Host=ep-your-endpoint.region.aws.neon.tech;Port=5432;Database=swiftdrop_identity;Username=REPLACE_WITH_IDENTITY_MIGRATION_ROLE;Password=REPLACE_WITH_PRIVATE_PASSWORD;SSL Mode=Require

# Broker administration only; never passed to application workloads. Generated
# locally by run.sh if no private override exists. No broker adapter is active.
RABBITMQ_DEFAULT_PASS=GENERATE_LOCALLY
