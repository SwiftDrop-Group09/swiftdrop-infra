# Copy to .env and replace every placeholder with values from your own Neon
# project. Never commit the populated .env file or share live connection strings.
# This file is a template only; Compose rejects unset/empty required passwords.

# Create four Neon databases/roles as planned and replace the example host,
# database, username, and password fields. Require TLS for every connection.
# The backend will receive one ConnectionStrings__Database value per service.
IDENTITY_DATABASE_CONNECTION_STRING=Host=ep-your-endpoint.region.aws.neon.tech;Port=5432;Database=swiftdrop_identity;Username=identity_app;Password=REPLACE_WITH_IDENTITY_ROLE_PASSWORD;SSL Mode=Require;Trust Server Certificate=false
DELIVERY_DATABASE_CONNECTION_STRING=Host=ep-your-endpoint.region.aws.neon.tech;Port=5432;Database=swiftdrop_delivery;Username=delivery_app;Password=REPLACE_WITH_DELIVERY_ROLE_PASSWORD;SSL Mode=Require;Trust Server Certificate=false
MERCHANT_DATABASE_CONNECTION_STRING=Host=ep-your-endpoint.region.aws.neon.tech;Port=5432;Database=swiftdrop_merchant;Username=merchant_app;Password=REPLACE_WITH_MERCHANT_ROLE_PASSWORD;SSL Mode=Require;Trust Server Certificate=false
NOTIFICATIONS_DATABASE_CONNECTION_STRING=Host=ep-your-endpoint.region.aws.neon.tech;Port=5432;Database=swiftdrop_notifications;Username=notifications_app;Password=REPLACE_WITH_NOTIFICATIONS_ROLE_PASSWORD;SSL Mode=Require;Trust Server Certificate=false

BROKER_ADMIN_PASSWORD=
DELIVERY_BROKER_PASSWORD=
WORKER_BROKER_PASSWORD=

OBJECT_ROOT_PASSWORD=
DELIVERY_OBJECT_ACCESS_KEY=delivery-local
DELIVERY_OBJECT_SECRET_KEY=

# The docs identify these image names, but mark latest as an unpinned local
# placeholder. Pin and verify versions before using this stack beyond local dev.
OBJECT_STORE_IMAGE=minio/minio:latest
OBJECT_CLIENT_IMAGE=minio/mc:latest
JWT_ISSUER=https://identity.example.invalid
JWT_AUDIENCE=swiftdrop-api-local
GOOGLE_WEB_CLIENT_ID=REPLACE_WITH_WEB_CLIENT_ID
GOOGLE_ANDROID_CLIENT_ID=REPLACE_WITH_ANDROID_CLIENT_ID
WEB_ORIGIN=http://localhost:5173
